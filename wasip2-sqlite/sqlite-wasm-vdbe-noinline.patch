 /*
+** Keep OP_OpenDup's cursor-allocation call chain out of sqlite3VdbeExec on
+** WebAssembly. Native builds may inline this helper as before.
+*/
+static int SQLITE_WASM_VDBE_NOINLINE vdbeExecOpenDup(Vdbe *p, Op *pOp){
+  VdbeCursor *pOrig;
+  VdbeCursor *pCx;
+  int rc;
+
+  pOrig = p->apCsr[pOp->p2];
+  assert( pOrig );
+  assert( pOrig->isEphemeral );
+  pCx = allocateCursor(p, pOp->p1, pOrig->nField, CURTYPE_BTREE);
+  if( pCx==0 ) return SQLITE_NOMEM;
+  pCx->nullRow = 1;
+  pCx->isEphemeral = 1;
+  pCx->pKeyInfo = pOrig->pKeyInfo;
+  pCx->isTable = pOrig->isTable;
+  pCx->pgnoRoot = pOrig->pgnoRoot;
+  pCx->isOrdered = pOrig->isOrdered;
+  pCx->ub.pBtx = pOrig->ub.pBtx;
+  pCx->noReuse = 1;
+  pOrig->noReuse = 1;
+  rc = sqlite3BtreeCursor(pCx->ub.pBtx, pCx->pgnoRoot, BTREE_WRCSR,
+                          pCx->pKeyInfo, pCx->uc.pCursor);
+  assert( rc==SQLITE_OK );
+  return rc;
+}
