+/* WASM linear memory is little-endian. Compare complete words only inside
+** the requested range; memcpy permits unaligned accesses without aliasing UB.
+** Return the unsigned-byte difference at the first mismatch, as memcmp does.
+*/
+#if defined(__wasm__)
+static SQLITE_NOINLINE int sqlite3WasmMemcmp(
+  const void *pLeft, const void *pRight, size_t n
+){
+  const unsigned char *a = (const unsigned char*)pLeft;
+  const unsigned char *b = (const unsigned char*)pRight;
+  while( n>=8 ){
+    u64 x, y;
+    memcpy(&x, a, 8);
+    memcpy(&y, b, 8);
+    if( x!=y ){
+      unsigned shift = (unsigned)__builtin_ctzll(x^y) & ~7u;
+      return (int)((x>>shift)&255) - (int)((y>>shift)&255);
+    }
+    a += 8;
+    b += 8;
+    n -= 8;
+  }
+  while( n-- ){
+    int diff = (int)*a++ - (int)*b++;
+    if( diff ) return diff;
+  }
+  return 0;
+}
+#define memcmp(a,b,n) __builtin_choose_expr(__builtin_constant_p(n), \
+  __builtin_memcmp((a),(b),(n)), sqlite3WasmMemcmp((a),(b),(n)))
+#endif
 
