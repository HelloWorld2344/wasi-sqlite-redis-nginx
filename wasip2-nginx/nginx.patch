diff --git a/src/os/unix/ngx_readv_chain.c b/src/os/unix/ngx_readv_chain.c
index 48fa0a7..1d100a7 100644
--- a/src/os/unix/ngx_readv_chain.c
+++ b/src/os/unix/ngx_readv_chain.c
@@ -122,7 +122,24 @@ ngx_readv_chain(ngx_connection_t *c, ngx_chain_t *chain, off_t limit)
                    "readv: %ui, last:%uz", vec.nelts, iov->iov_len);
 
     do {
+#ifdef __wasi__
+        /* wasi-libc p2 的 readv 只读第一个 iov（实测），逐段 read 代替 */
+        {
+            struct iovec *iovs = (struct iovec *) vec.elts;
+            n = 0;
+            for (ngx_uint_t i = 0; i < vec.nelts; i++) {
+                ssize_t rc = read(c->fd, iovs[i].iov_base, iovs[i].iov_len);
+                if (rc <= 0) {
+                    if (n == 0) { n = rc; }
+                    break;
+                }
+                n += rc;
+                if ((size_t) rc < iovs[i].iov_len) break;
+            }
+        }
+#else
         n = readv(c->fd, (struct iovec *) vec.elts, vec.nelts);
+#endif
 
         if (n == 0) {
             rev->ready = 0;
diff --git a/src/os/unix/ngx_writev_chain.c b/src/os/unix/ngx_writev_chain.c
index e38a3aa..ba2203e 100644
--- a/src/os/unix/ngx_writev_chain.c
+++ b/src/os/unix/ngx_writev_chain.c
@@ -186,7 +186,26 @@ ngx_writev(ngx_connection_t *c, ngx_iovec_t *vec)
 
 eintr:
 
+#ifdef __wasi__
+    /* wasi-libc p2 的 writev 只写第一个 iov（实测），逐段 write 代替 */
+    {
+        ssize_t total = 0;
+        for (ngx_uint_t i = 0; i < vec->count; i++) {
+            ssize_t rc = write(c->fd, vec->iovs[i].iov_base, vec->iovs[i].iov_len);
+            if (rc == -1) {
+                if (total) { n = total; goto eintr_done; }
+                n = -1;
+                goto eintr_done;
+            }
+            total += rc;
+            if ((size_t) rc < vec->iovs[i].iov_len) break;
+        }
+        n = total;
+    }
+eintr_done:
+#else
     n = writev(c->fd, vec->iovs, vec->count);
+#endif
 
     ngx_log_debug2(NGX_LOG_DEBUG_EVENT, c->log, 0,
                    "writev: %z of %uz", n, vec->size);
